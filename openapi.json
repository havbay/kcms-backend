{
  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "actor": {
            "default": "demo-client",
            "title": "Actor",
            "type": "string"
          },
          "kind": {
            "enum": [
              "LEAVE",
              "HIDE",
              "UNHIDE"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
      "DatabaseStatus": {
        "enum": [
          "REACHABLE",
          "UNREACHABLE"
        ],
        "title": "DatabaseStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "contract_version": {
            "examples": [
              "1.0.0"
            ],
            "title": "Contract Version",
            "type": "string"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "service": {
            "examples": [
              "kcms-backend"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "required": [
          "service",
          "status",
          "database",
          "contract_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HistoryEntry": {
        "properties": {
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "actor",
          "occurred_at"
        ],
        "title": "HistoryEntry",
        "type": "object"
      },
      "ServiceStatus": {
        "enum": [
          "READY",
          "DEGRADED"
        ],
        "title": "ServiceStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkListItem"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "WorkList",
        "type": "object"
      },
      "WorkListItem": {
        "properties": {
          "abstain": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstain"
          },
          "author_ref": {
            "title": "Author Ref",
            "type": "string"
          },
          "comment_id": {
            "title": "Comment Id",
            "type": "string"
          },
          "latest_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Action"
          },
          "latest_action_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Action At"
          },
          "latest_actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Actor"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "posted_at": {
            "format": "date-time",
            "title": "Posted At",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "severity_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity Confidence"
          },
          "surfaced_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Surfaced Reason"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "target_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Confidence"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "comment_id",
          "text",
          "author_ref",
          "posted_at",
          "severity",
          "severity_confidence",
          "target",
          "target_confidence",
          "abstain",
          "surfaced_reason",
          "rationale",
          "model_version",
          "latest_action",
          "latest_actor",
          "latest_action_at"
        ],
        "title": "WorkListItem",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "KCMS Backend",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/comments": {
      "get": {
        "operationId": "listComments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Comments"
      }
    },
    "/api/v1/comments/{comment_id}/actions": {
      "post": {
        "description": "Records a moderation Action. Actions are append-only and reversible,\nand never become training labels.",
        "operationId": "recordAction",
        "parameters": [
          {
            "in": "path",
            "name": "comment_id",
            "required": true,
            "schema": {
              "title": "Comment Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HistoryEntry"
                  },
                  "title": "Response Recordaction",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record Action"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          }
        },
        "summary": "Database-aware service health"
      }
    }
  }
}
